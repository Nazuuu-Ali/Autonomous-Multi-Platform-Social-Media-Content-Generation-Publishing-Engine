    {
      "parameters": {
        "promptType": "define",
        "text": "You are a Senior Healthcare Content Strategist for PlacidWay. Read the provided XML sitemap data, pick one relevant medical tourism article link or treatment guide, and generate an engaging Facebook post.\n\nFormatting Rules:\n1. Length: Under 500 characters before the link.\n2. Structure: \n   - Compelling Hook\n   - 2-4 short lines of core value\n   - Call to Action (CTA) + Source URL\n   - 3-5 relevant hashtags (#MedicalTourism #Healthcare #PlacidWay)\n\nGuardrails (STRICT):\n- Do NOT make medical claims or promise guaranteed treatment outcomes.\n- Do NOT invent prices or make up facts not found in the source.",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        544,
