    {
      "parameters": {
        "jsCode": "// Workflow ki global memory (static data) lete hain taaki URL save rahein\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.postedUrls) {\n  staticData.postedUrls = [];\n}\n\nconst filteredItems = [];\n\n// Jitne bhi items XML node se aa rahe hain, un sab ko loop mein check karte hain\nfor (const item of $input.all()) {\n  // XML output ke mutabiq link ya url field ko target karte hain\n  const postUrl = item.json.link || item.json.url;\n  \n  if (postUrl) {\n    // Check karo ke URL pehle se saved hai ya nahi\n    if (!staticData.postedUrls.includes(postUrl)) {\n      // Agar naya URL hai, toh list mein save karo aur aage bhej do\n      staticData.postedUrls.push(postUrl);\n      filteredItems.push(item);\n    }\n    // Agar pehle se hai, toh skip ho jayega (aage nahi jayega)\n  } else {\n    // Agar kisi item mein link na ho, toh safe side ke taur par usko pass hone do taaki error na aaye\n    filteredItems.push(item);\n  }\n}\n\nreturn filteredItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        16
      ],
      "id": "af9aad8a-728d-4b1b-96d7-f83af6fe48e0",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// AI Agent se aane wala text ya output lete hain\nconst item = $input.item;\nlet postText = item.json.output || \"\";\n\n// Banned medical claims ya exact pricing ke keywords jo check karne hain\nconst bannedKeywords = [\"guaranteed cure\", \"100% cure\", \"cure all\", \"exact price\", \"$\"];\nlet hasViolation = false;\n\n// Check karte hain ke text mein koi banned word hai ya nahi\nfor (const word of bannedKeywords) {\n  if (postText.toLowerCase().includes(word.toLowerCase())) {\n    hasViolation = true;\n    break;\n  }\n}\n\n// Agar koi violation milti hai, toh safe fallback text set kar do\nif (hasViolation) {\n  postText = \"Explore world-class medical tourism options, treatment packages, and expert healthcare guides with PlacidWay. Discover the care you deserve! #MedicalTourism #Healthcare #PlacidWay\";\n}\n\n// Sanitized text ko aage Facebook Publish node ke liye pass karte hain\nitem.json.sanitized_output = postText;\nreturn item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
